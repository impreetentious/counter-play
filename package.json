{
  "name": "counter-play",
  "version": "0.16.2",
  "private": true,
  "packageManager": "npm@11.12.0",
  "engines": {
    "node": "24.14.0",
    "npm": "11.12.0"
  },
  "scripts": {
    "dev": "next dev -p 3001",
    "build": "next build",
    "start": "serve -l 4001 --config ../serve.json out",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "PLAYWRIGHT_BROWSERS_PATH=0 playwright test",
    "test:all": "npm run check:version && npm run typecheck && npm run lint && npm run check:citations && npm run format:check && npm run test && npm run build && npm run perf:budgets && npm run check:csp && npm run test:e2e",
    "perf:budgets": "vitest run --config vitest.perf.config.ts",
    "check:version": "node scripts/check-version-coherence.mjs",
    "check:citations": "node scripts/check-citations.mjs",
    "check:csp": "node scripts/check-csp.mjs"
  },
  "dependencies": {
    "next": "16.2.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "zod": "~4.3.6",
    "zustand": "~5.0.12"
  },
  "devDependencies": {
    "@axe-core/playwright": "~4.11.1",
    "@playwright/test": "~1.58.2",
    "@tailwindcss/postcss": "~4.2.2",
    "@types/node": "~25.5.0",
    "@types/react": "~19.2.14",
    "@types/react-dom": "~19.2.3",
    "@typescript-eslint/eslint-plugin": "~8.57.2",
    "@typescript-eslint/parser": "~8.57.2",
    "@next/eslint-plugin-next": "~16.2.1",
    "eslint": "~9.39.4",
    "fast-check": "~4.6.0",
    "postcss": "~8.5.8",
    "prettier": "~3.8.1",
    "serve": "~14.2.6",
    "tailwindcss": "~4.2.2",
    "typescript": "~5.9.3",
    "vitest": "~4.1.1"
  },
  "overrides": {
    "postcss": "$postcss",
    "sharp": "~0.34.5",
    "fast-uri": "~3.1.0",
    "minimatch@3": {
      "brace-expansion": "~1.1.12"
    }
  },
  "license": "MIT",
  "author": "Sidakpreet Singh",
  "description": "Client-side sales compensation plan simulator and perverse-incentive linter.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ItsMonarch04/counter-play.git"
  },
  "bugs": {
    "url": "https://github.com/ItsMonarch04/counter-play/issues"
  },
  "homepage": "https://github.com/ItsMonarch04/counter-play",
  "allowScripts": {
    "fsevents@2.3.2": true,
    "fsevents@2.3.3": true
  }
}
