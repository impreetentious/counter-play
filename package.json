{
  "name": "app",
  "version": "0.1.3",
  "private": true,
  "engines": {
    "node": "24.12.0"
  },
  "scripts": {
    "dev": "next dev -p 3001",
    "build": "next build",
    "start": "serve -l 4001 out",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "PLAYWRIGHT_BROWSERS_PATH=0 playwright test",
    "test:all": "npm run typecheck && npm run lint && npm run test && npm run build && npm run test:e2e"
  },
  "dependencies": {
    "next": "16.0.10",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "zod": "~4.1.13",
    "zustand": "~5.0.9"
  },
  "devDependencies": {
    "@axe-core/playwright": "~4.11.0",
    "@playwright/test": "~1.57.0",
    "@tailwindcss/postcss": "~4.1.18",
    "@types/node": "~25.0.1",
    "@types/react": "~19.2.7",
    "@types/react-dom": "~19.2.3",
    "autoprefixer": "~10.4.22",
    "eslint": "~9.39.1",
    "eslint-config-next": "~16.0.10",
    "fast-check": "~4.4.0",
    "postcss": "~8.5.6",
    "serve": "~14.2.5",
    "tailwindcss": "~4.1.18",
    "typescript": "~5.9.3",
    "vitest": "~4.0.15"
  }
}
